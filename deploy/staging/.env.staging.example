# ─── aie-matrix staging environment variables ─────────────────────────────────
# Copy this file to deploy/staging/.env.staging and fill in your values.
# .env.staging is gitignored — NEVER commit secrets.
# See: specs/016-staging-deployment/contracts/env-contract.md (IC-002)

# ─── Neo4j (required) ─────────────────────────────────────────────────────────
# URI for the Neo4j bolt endpoint. In staging, the service name is "neo4j".
NEO4J_URI=bolt://neo4j:7687

# Application credentials (separate from NEO4J_AUTH used by the Neo4j image)
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-in-staging

# Neo4j Docker image auth in "user/password" format (used only by the neo4j container)
NEO4J_AUTH=neo4j/change-me-in-staging

# ─── Redis (optional — enables pub-sub; RedisPresence not yet wired) ──────────
# In staging, the service name is "redis".
REDIS_URL=redis://redis:6379

# ─── Combined server (aie-matrix/server) ──────────────────────────────────────
# HTTP port the server listens on inside the container.
AIE_MATRIX_HTTP_PORT=8787

# Internal fanout token for POST /internal/world-fanout (leave blank to disable)
AIE_MATRIX_INTERNAL_FANOUT_TOKEN=

# Debug logging (set to "true" to enable verbose ghost movement logs)
AIE_MATRIX_DEBUG=false

# Map file path relative to repo root (unset = active map from Neo4j)
# AIE_MATRIX_MAP=maps/sandbox/freeplay.map.gram

# Conversation data directory (unset = Neo4j-backed store, deferred)
# CONVERSATION_DATA_DIR=/data/conversations

# ─── Agent Host (aie-matrix/server-agent-host) ────────────────────────────────
# Dev token required by agent-host for all authenticated requests.
GHOST_HOUSE_DEV_TOKEN=change-me-dev-token

# Port agent-host listens on inside the container.
GHOST_HOUSE_PORT=4000

# Public base URL advertised in the A2A agent card.
# Must be the externally reachable URL (e.g. via port mapping on the host).
GHOST_HOUSE_PUBLIC_BASE_URL=http://localhost:4000

# ─── Inter-service URLs (IC-002) ─────────────────────────────────────────────
# HTTP base URL of the combined server — used by agent-host health check.
# In staging, the compose service name is "server".
WORLD_API_URL=http://server:8787

# WebSocket URL of the Colyseus server — used by agent-host Colyseus bridge.
COLYSEUS_URL=ws://server:8787

# ─── GCS (optional — map artifact storage) ───────────────────────────────────
# Leave blank to use local file fallback in staging.
# GCS_BUCKET=your-gcs-bucket-name

# ─── Node / runtime ──────────────────────────────────────────────────────────
NODE_ENV=production
