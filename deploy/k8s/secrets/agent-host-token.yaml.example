# K8s Secret template for agent-host bearer token — ADR-0009, Spec 018
#
# Usage (first time only):
#   kubectl create secret generic agent-host-token \
#     --from-literal=AGENT_HOST_TOKEN="<strong-random-token>"
#
# Or apply this template (base64-encode your token first):
#   echo -n "<your-token>" | base64
#   # paste result into data.AGENT_HOST_TOKEN below
#   kubectl apply -f agent-host-token.yaml
#
# This file is gitignored when populated. NEVER commit real tokens.
# The .example file (this file) is safe to commit — it contains only placeholders.
---
apiVersion: v1
kind: Secret
metadata:
  name: agent-host-token
type: Opaque
data:
  # base64-encoded bearer token — must match agent-host's AGENT_HOST_TOKEN
  # Generate: echo -n "$(openssl rand -hex 32)" | base64
  AGENT_HOST_TOKEN: REPLACE_WITH_BASE64_ENCODED_TOKEN
