# Base URL for all server endpoints (Colyseus, world API, ghost house).
# The WebSocket URL (wss://) is derived automatically from this value.
# Production: https://matrix.relateby.dev
# Local dev:  http://127.0.0.1:8787
VITE_API_BASE_URL=http://127.0.0.1:8787

# Optional: bearer for catalog / conversation routes when the server requires auth
# VITE_GHOST_HOUSE_BEARER=

# Optional: ghost id for paired flows (`?ghost=` also supported)
VITE_DEV_GHOST_ID=
