# Base URL for all server endpoints.
# Production: https://api.matrix.neo4j.gg
# Local dev:  http://localhost:8787
VITE_API_BASE_URL=http://localhost:8787

# Admin bearer token for write operations (publish, archive, start/end session).
# Required at runtime for admin ops; build succeeds without it.
VITE_ADMIN_TOKEN=

# Agent-host URL for ghost management (admin SPA only).
# Production: https://api.matrix.neo4j.gg (or via IAP tunnel)
# Local dev:  http://localhost:4000
VITE_AGENT_HOST_URL=http://localhost:4000

# Bearer token for agent-host authentication. Same value as AGENT_HOST_TOKEN
# in aie-matrix-secrets. Required at runtime for all agent-host operations.
VITE_AGENT_HOST_BEARER=

# Set to "true" to enable Mock Service Worker — intercepts all API calls with
# in-browser fixtures. No backend services needed. For local UI development only.
# Never set this in production builds.
VITE_MOCK_API=false
