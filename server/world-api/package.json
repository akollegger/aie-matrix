{
  "name": "@aie-matrix/server-world-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "TESTCONTAINERS_RYUK_DISABLED=true node --import tsx --test \"src/**/*.test.ts\" \"test/**/*.test.ts\"",
    "test:integration": "TESTCONTAINERS_RYUK_DISABLED=true node --import tsx --test --test-concurrency=1 \"test/**/*.integration.test.ts\""
  },
  "dependencies": {
    "@aie-matrix/logger": "workspace:*",
    "@aie-matrix/map-gram": "workspace:*",
    "@aie-matrix/server-auth": "workspace:*",
    "@aie-matrix/server-colyseus": "workspace:*",
    "@aie-matrix/server-conversation": "workspace:*",
    "@aie-matrix/shared-types": "workspace:*",
    "@google-cloud/storage": "^7.15.2",
    "@js-temporal/polyfill": "^0.5.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@relateby/pattern": "^0.4.0",
    "busboy": "^1.6.0",
    "effect": "^3.21.0",
    "h3-js": "^4.1.0",
    "ioredis": "^5.4.2",
    "neo4j-driver": "^5.28.3",
    "ulid": "^2.3.0",
    "unique-names-generator": "^4.7.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "testcontainers": "^12.0.2",
    "tsx": "^4.21.0"
  }
}
