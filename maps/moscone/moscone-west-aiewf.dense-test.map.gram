{ kind: "matrix-map", name: "untitled-map", elevation: 0 }

(floor:TileType:Floor { name: "Floor" })
(room:TileType:Room { name: "Room", style: css`background: #46074b` })
(void:TileType:Void { name: "Void", style: css`background: #454545` })

(vendingMachine:ItemType:VendingMachine { name: "Vending Machine", glyph: "🛒", takeable: false, capacityCost: 1 })

[resources:Resources { name: "World Economy" } |
    (:Resource { id: "gold", class: "conserved", qty: 1000000, floor: 0, label: "Gold" }),
    (:Resource { id: "food-water", class: "conserved", qty: 10000, floor: 0, label: "Bottle of Water" }),
    (:Resource { id: "food-bread", class: "conserved", qty: 10000, floor: 0, label: "Bread Roll" }),
    (:Resource { id: "food-salad", class: "conserved", qty: 10000, floor: 0, label: "Garden Salad" }),
