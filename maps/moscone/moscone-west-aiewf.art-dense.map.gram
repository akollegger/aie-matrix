{ kind: "matrix-map", name: "untitled-map", elevation: 0 }

(floor:TileType:Floor { name: "Floor" })
(room:TileType:Room { name: "Room", style: css`background: #46074b` })
(void:TileType:Void { name: "Void", style: css`background: #454545` })

(vendingMachine:ItemType:VendingMachine { name: "Vending Machine", glyph: "🛒", takeable: false, capacityCost: 1 })
