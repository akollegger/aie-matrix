{ kind: "matrix-character" }

(charCollector:Character { id: "collector", name: "The Collector", glyph: "🎒",
  background: "An enthusiastic attendee who roams the fair looking for interesting items to add to their collection.",
  enabled: true, defaultAction: "go-random" })

(idle:DialogNode    { responses: ["Oh, hello! I'm always on the lookout for rare finds. Ask me anything.", "Hey there! Have you spotted anything interesting?"] })
(items:DialogNode   { responses: ["I've found a few things today. The best items are near the demo booths!", "Looking for more. Check near the sponsor area — good finds there."] })
(trade:DialogNode   { responses: ["I might be interested. What do you have?", "Let me think about that one..."] })
(farewell:DialogNode { responses: ["Happy hunting!", "See you around the fair!"] })

[dialog_1:DialogTree |
  (idle)-[:DialogTrigger { triggers: ["item","find","collect","what","have","got"] }]->(items),
  (idle)-[:DialogTrigger { triggers: ["trade","offer","swap","exchange"] }]->(trade),
  (idle)-[:DialogTrigger { triggers: ["bye","see","later","goodbye"] }]->(farewell),
  (idle)-[:DialogTrigger { triggers: [] }]->(idle),
  (items)-[:DialogTrigger { triggers: ["trade","offer","swap"] }]->(trade),
  (items)-[:DialogTrigger { triggers: [] }]->(idle),
  (trade)-[:DialogTrigger { triggers: [] }]->(idle),
  (farewell)-[:DialogTrigger { triggers: [] }]->(idle)
]

[behavior_1:Behaviors |
  (b1:Rule { when: "item_here",     do: "take"                        }),
  (b2:Rule { when: "item_adjacent", do: "go",   toward: "nearest_item" }),
  (b3:Rule { when: "alone",         do: "go",   toward: "random"       }),
  (b4:Rule { when: "always",        do: "go",   toward: "random"       })
]

(charCollector)-[:HAS_DIALOG]->(dialog_1)
(charCollector)-[:EXHIBITS_BEHAVIOR]->(behavior_1)
