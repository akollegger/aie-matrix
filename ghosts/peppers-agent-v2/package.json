{
  "name": "@aie-matrix/ghost-peppers-agent-v2",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "prebuild": "pnpm --filter @aie-matrix/root-env run build && pnpm --filter @aie-matrix/ghost-ts-client run build && pnpm --filter @aie-matrix/ghost-peppers-inner run build && pnpm --filter @aie-matrix/ghost-peppers-mem run build",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node --import tsx src/agent.ts",
    "start": "node dist/agent.js"
  },
  "dependencies": {
    "@a2a-js/sdk": "^0.3.13",
    "@aie-matrix/ghost-peppers-inner": "workspace:*",
    "@aie-matrix/ghost-peppers-mem": "workspace:*",
    "@aie-matrix/ghost-peppers-router": "workspace:*",
    "@aie-matrix/ghost-peppers-sleep": "workspace:*",
    "@aie-matrix/ghost-ts-client": "workspace:*",
    "@aie-matrix/root-env": "workspace:*",
    "@aie-matrix/shared-types": "workspace:*",
    "@openai/agents": "^0.11.6",
    "express": "^4.21.2",
    "openai": "^4.85.0",
    "ulid": "^2.3.0",
    "unique-names-generator": "^4.7.1",
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^24.12.2",
    "tsx": "^4.21.0",
    "typescript": "~5.7.3"
  }
}
