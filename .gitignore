# Environment & secrets (never commit real values)
.env
.env.*
!.env.example
!.env.staging.example

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
# setuptools / legacy layouts (repo-root only — avoids ignoring packages named lib/, var/, etc.)
/lib/
/lib64/
/parts/
/var/
sdist/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.venv/
venv/
/ENV/
/env/

# Test & type-check caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.tox/
.nox/
htmlcov/
.coverage
.coverage.*
nosetests.xml
coverage.xml
*.cover
*.py,cover

# Jupyter
.ipynb_checkpoints/

# Tiled editor local session (absolute paths; noisy diffs)
*.tiled-session

# Per-user workspace chrome (Matrix theme, etc.) — keep local, never track.
.vscode/settings.json

# --- Misc ---
*.log
tmp/
temp/

.claude/*.lock
.claude/worktrees/

# Sibling reference clone — pokerswarm-ai vendored for the RDC fork.
# Not part of this repo. Keep alongside but never tracked.
/pokerswarm-ai/

# RDC runtime artifacts — Cyphers ledger + per-hand audit log live
# under .local/ next to each running session. Never commit; the file
# grows unbounded and is per-developer state.
ghosts/*/ghosts/rdc-orchestrator/.local/
.local/
